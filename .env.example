# Ovryth environment. Copy to .env.local. Never commit real values.

# App
PUBLIC_ORIGIN=http://localhost:3400
NEXT_PUBLIC_CHAIN_ID=8453

# Base mainnet
BASE_RPC_URL=https://mainnet.base.org
BASE_RPC_FALLBACK_1=https://base.publicnode.com
BASE_RPC_FALLBACK_2=
USDC_ADDRESS=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913
SPEND_PERMISSION_MANAGER=0xf85210B21cC50302F477BA56686d2019dC9b67Ad
# Deployed OvrythPayer address (Task 7). Also exposed to the browser for onboarding.
NEXT_PUBLIC_PAYER_ADDRESS=
# Operator key: only ever calls OvrythPayer.pay(); holds gas ETH only.
OVRYTH_OPERATOR_PRIVATE_KEY=

# Database (dedicated Supabase project `ovryth`)
DATABASE_URL=postgresql://user:pass@host:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://user:pass@host:5432/postgres

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=ovryth_bot
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_ADMIN_CHAT_ID=

# LLM
GEMINI_API_KEY=
GROQ_API_KEY=

# Sweeper
TICK_SECRET=

# Optional
ETHERSCAN_API_KEY=
SHOWCASE_ROOM_SLUG=
