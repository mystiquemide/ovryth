# Ovryth environment. Copy to .env.local. Never commit real values.

# App
PUBLIC_ORIGIN=http://localhost:3400
NEXT_PUBLIC_CHAIN_ID=8453

# Base mainnet
BASE_RPC_URL=https://mainnet.base.org
BASE_RPC_FALLBACK_1=https://base.publicnode.com
BASE_RPC_FALLBACK_2=
USDC_ADDRESS=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913
SPEND_PERMISSION_MANAGER=0xf85210B21cC50302F477BA56686d2019dC9b67Ad
# Deployed OvrythPayer address (Task 7). Also exposed to the browser for onboarding.
# Base mainnet deployment: 0x485457f86fbf5e2385ae183bd5518c7d965e3999
NEXT_PUBLIC_PAYER_ADDRESS=
# Operator key: only ever calls OvrythPayer.pay(); holds gas ETH only.
OVRYTH_OPERATOR_PRIVATE_KEY=

# Database (Neon serverless Postgres, project `ovryth`).
# DATABASE_URL = pooled endpoint (-pooler host) used at runtime via the pg adapter.
# DIRECT_URL   = direct (unpooled) endpoint used for prisma migrate.
# Keep TLS hostname verification explicit so future pg/libpq behavior cannot weaken it.
DATABASE_URL=postgresql://user:pass@ep-xxxx-pooler.region.aws.neon.tech/ovryth?sslmode=verify-full
DIRECT_URL=postgresql://user:pass@ep-xxxx.region.aws.neon.tech/ovryth?sslmode=verify-full

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=ovryth_bot
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_ADMIN_CHAT_ID=

# LLM
GEMINI_API_KEY=
GROQ_API_KEY=

# Sweeper
TICK_SECRET=
CRON_SECRET=

# Optional
ETHERSCAN_API_KEY=
SHOWCASE_ROOM_SLUG=

# CDP Paymaster + Bundler endpoint (server-only, contains client key)
CDP_PAYMASTER_URL=
